{
  "name": "bank-service-ms",
  "version": "0.0.1",
  "description": "A microservice to handle core banking operations.",
  "main": "index.js",
  "keywords": [],
  "author": "Inizio",
  "license": "MIT",
  "scripts": {
    "build": "gulp build",
    "rebuild": "gulp rebuild",
    "watch": "gulp watch",
    "clean": "gulp clean",
    "start": "gulp",
    "watch:server": "nodemon \"./dist/index.js\" --watch \"./dist\"",
    "start-docker": "nodemon --exec ts-node src/index.ts --config nodemon-docker.json --legacy-watch",
    "dev:debug": "nodemon --inspect src/index.ts",
    "test:e2e": "mocha --reporter spec --require ./node_modules/ts-node/register tests/**/*.test.ts --timeout=30000",
    "test:unit": "mocha --reporter spec --require ts-node/register --require src/index.spec.ts src/**/*.spec.ts --exit",
    "test:unit-pipeline": "nyc --reporter=cobertura mocha --reporter mocha-junit-reporter --require ./node_modules/ts-node/register src/**/*.spec.ts",
    "lint": "./node_modules/.bin/eslint ./src/**/*.ts --fix",
    "test:coverage": "nyc --reporter=text mocha --reporter spec --require ts-node/register src/**/*.spec.ts --exit"
  },
  "overrides": {
    "glob-parent": "6.0.2",
    "jsonwebtoken": "9.0.0"
  },
  "dependencies": {
    "@neudesic/inizio-app-builder": "0.0.4-rc.2",
    "@neudesic/inizio-circuit-breaker": "0.0.4-rc.2",
    "@neudesic/inizio-configuration-manager": "0.0.4-rc.2",
    "@neudesic/inizio-ddd-utils": "0.0.4-rc.2",
    "@neudesic/inizio-health-check": "0.0.4-rc.2",
    "@neudesic/inizio-logger": "0.0.4-rc.2",
    "@neudesic/inizio-metrics": "0.0.4-rc.2",
    "@neudesic/inizio-node-core": "0.0.4-rc.2",
    "@neudesic/inizio-sql": "0.0.4-rc.2",
    "@neudesic/inizio-redis": "0.0.4",
    "typeorm": "0.3.15",
    "reflect-metadata": "0.1.13",
    "tslib": "2.4.1",
    "uuid": "^8.3.2",
    "pg": "^8.11.3",
    "inversify-express-utils": "6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "@neudesic/inizio-kafka": "0.0.3"
  },
  "devDependencies": {
    "@types/chai": "4.3.4",
    "@types/mocha": "10.0.1",
    "@types/node": "18.11.17",
    "@types/uuid": "^9.0.1",
    "@typescript-eslint/eslint-plugin": "~5.59.2",
    "@typescript-eslint/parser": "~5.59.2",
    "chai": "4.3.7",
    "del": "^5.0.0",
    "eslint": "~8.39.0",
    "eslint-config-airbnb-base": "~15.0.0",
    "eslint-plugin-import": "2.27.5",
    "glob-parent": "6.0.2",
    "gulp-env": "^0.4.0",
    "gulp-eslint-new": "^1.1.2",
    "gulp-nodemon": "^2.2.1",
    "gulp-typescript": "^6.0.0-alpha.1",
    "mocha": "~10.2.0",
    "mocha-junit-reporter": "~2.2.0",
    "nodemon": "~2.0.22",
    "nyc": "~15.1.0",
    "ts-loader": "~9.4.2",
    "ts-node": "~10.9.1",
    "typed-promisify": "~0.4.0",
    "typemoq": "~2.1.0",
    "typescript": "~5.0.4"
  }
}
