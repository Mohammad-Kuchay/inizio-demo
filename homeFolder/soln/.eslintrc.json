{
    "root": true,
    "env": {
        "es2022": true,
        "node": true,
        "mocha": true
    },
    "extends": [
        "airbnb-base"
    ],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module",
        "project": "./tsconfig.json"
    },
    "plugins": ["@typescript-eslint"],
    "rules": {
        "indent": ["error", 4],
        "quotes": ["error", "double"],
        "semi": ["error", "always"],
        "no-console": 2,
        "no-underscore-dangle": 0,
        "import/no-unresolved": 0,
        "max-len": 0,
        "import/prefer-default-export": 0,
        "radix": 0,
        "no-plusplus": 0,
        "comma-dangle": ["error", {
            "arrays": "never",
            "objects": "never",
            "imports": "never",
            "exports": "never",
            "functions": "never"
        }],
        "arrow-body-style": 0,
        "import/no-extraneous-dependencies": 0,
        "class-methods-use-this": 0,
        "no-use-before-define": 0,
        "import/no-cycle": 0,
        "import/extensions": 0,
        "no-useless-constructor": 0,
        "linebreak-style": 0,
        "no-shadow": 0,
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "error"
    },
    "settings": {
        "import/extensions": [".js", ".ts"],
        "import/parsers": {
            "@typescript-eslint/parser": [".ts"]
        },
        "import/resolver": {
            "node": {
                "extensions": [".js", ".ts"]
            }
        }
    }
}
