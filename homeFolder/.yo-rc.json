{
  "@neudesic/inizio-cli": {
    "basicInformation": {
      "description": "A service for managing banking operations",
      "domainName": "banking",
      "name": "bank-ms",
      "subDomainName": "accounts",
      "technology": "Nodejs",
      "version": "1.0.0"
    },
    "cachingConfiguration": {
      "configuration": {
        "connectionString": "localhost:6379"
      },
      "connectionMethod": "connectionString",
      "enabled": true,
      "provider": "Redis"
    },
    "databaseConfiguration": {
      "databases": [
        {
          "connectionMethod": "connectionString",
          "connectionOptions": {
            "connectionString": "postgres://username:password@hostname:5432/database"
          },
          "dbPurpose": "read-write",
          "dbType": "postgres"
        }
      ],
      "enabled": true
    },
    "devopsConfiguration": {
      "devopsRelativePath": "",
      "enabled": true,
      "environments": [],
      "repoConfiguration": {
        "basePath": "homeFolder",
        "commitMessage": "home commit message",
        "organisationName": "Mohammad-Kuchay",
        "provider": "github",
        "pullRequestConfiguration": {
          "createPullRequest": true,
          "pullRequestDescription": "This is a test pull request",
          "pullRequestTitle": "Created from copilot"
        },
        "repositoryName": "inizio-demo",
        "sourceBranch": "main",
        "targetBranch": "homeBranch"
      }
    },
    "domainModels": {
      "aggregates": [
        {
          "functions": [],
          "name": "Account",
          "properties": [
            {
              "accessModifier": "public",
              "isArray": false,
              "isStatic": false,
              "name": "accountNumber",
              "nullable": false,
              "type": "string"
            },
            {
              "accessModifier": "public",
              "isArray": false,
              "isStatic": false,
              "name": "accountHolderName",
              "nullable": false,
              "type": "string"
            },
            {
              "accessModifier": "public",
              "isArray": false,
              "isStatic": false,
              "name": "balance",
              "nullable": false,
