    "messagingSystemConfiguration": {
      "configuration": {
        "connectionConfig": {
          "brokers": "localhost:9092",
          "saslMechanism": "PLAIN",
          "saslPassword": "NOT_A_VALID_SASL_PASSWORD",
          "saslUsername": "NOT_A_VALID_SASL_USERNAME"
        },
        "consumerConfig": {
          "consumerGroupId": "inizio-01"
        },
        "enableConsumer": true,
        "enableProducer": true,
        "producerConfig": {
          "clientId": "inizio-01",
          "enableTransaction": true
        },
        "schemaRegistryConfig": {
          "enabled": true,
          "password": "NOT_A_VALID_SCHEMA_REGISTRY_PASSWORD",
          "url": "http://localhost:8081",
          "username": "NOT_A_VALID_SCHEMA_REGISTRY_USERNAME"
        }
      },
      "enabled": true,
      "provider": "Kafka"
    },
    "secretManagerConfiguration": {
      "configuration": {
        "clientId": "NOT_A_VALID_CLIENT_ID",
        "clientSecret": "NOT_A_VALID_CLIENT_SECRET",
