            {
              "accessModifier": "public",
              "isArray": false,
              "isStatic": false,
              "name": "phoneNumber",
              "nullable": false,
              "type": "string"
            }
          ]
        }
      ],
      "enums": [
        {
          "name": "AccountType",
          "values": [
            "SAVINGS",
            "CURRENT",
            "FIXED"
          ]
        }
      ],
      "integrationEvents": [
        {
          "eventType": "AccountCreatedIntegrationEvent",
